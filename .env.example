# Copy to .env for local use; on your host set these in its "Environment" panel.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=          # random 50+ chars:  python -c "import secrets;print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
DATABASE_URL=               # postgres://user:pass@host:5432/dbname   (managed PostgreSQL)
ANTHROPIC_API_KEY=          # from console.anthropic.com  (set a monthly spend limit there)
EXPERT_SIGNUP_CODE=         # secret code you give only to real experts (8+ chars)
SITE_URL=https://yourdomain.com     # used in password-reset emails
# Email for password reset (any SMTP account: Gmail app-password, Brevo, Resend, Zoho, ...)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=KISAN SATHI <noreply@yourdomain.com>
# Admin panel (moderation). Pick a private URL and create the first admin via these 3 variables:
ADMIN_URL=my-private-admin-path
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=you@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=          # long, unique password
# Optional
# GEMINI_API_KEY=            # free key from aistudio.google.com (tried first)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash-lite
# ANALYSIS_MODEL=claude-sonnet-5-5
# THROTTLE_SCAN=30/day      # scans per farmer per day
# THROTTLE_AUTH=60/hour     # login/register attempts per IP
# TOKEN_LIFETIME_DAYS=30